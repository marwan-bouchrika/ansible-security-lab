upstream flowdesk_web {
    zone flowdesk_web 64k;
{% for host in groups['web'] %}

        server {{ hostvars[host].ansible_default_ipv4.address }}:80{{ ' down' if host in lb_excluded else '' }};
{% endfor %}
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    
    server_name _;

    location / {
        proxy_pass http://flowdesk_web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}